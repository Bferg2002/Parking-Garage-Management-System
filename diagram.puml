@startuml

class User {
  -userId: int
  -name: String
  -email: String
  +registerVehicle(vehicle: Vehicle)
  +updateVehicle(vehicle: Vehicle)
  +viewAvailableSpaces(): int
}

class Employee {
  -employeeId: int
  -name: String
  +trackEntry(vehicle: Vehicle)
  +trackExit(vehicle: Vehicle)
  +calculateExpense(vehicle: Vehicle): double
  +checkRegistration(vehicle: Vehicle): boolean
}

class Vehicle {
  -vehicleId: int
  -licensePlate: String
  -isRegistered: boolean
  -entryTime: DateTime
  -exitTime: DateTime
  +calculateParkingDuration(): double
}

class ParkingGarage {
  -garageId: int
  -capacity: int
  -occupiedSpaces: int
  +getAvailableSpaces(): int
  +parkVehicle(vehicle: Vehicle)
  +removeVehicle(vehicle: Vehicle)
}

class ParkingRecord {
  -recordId: int
  -entryTime: DateTime
  -exitTime: DateTime
  -cost: double
  +calculateCost(): double
}

class Account {
  -accountId: int
  -vehicles: List<Vehicle>
  +addVehicle(vehicle: Vehicle)
  +removeVehicle(vehicle: Vehicle)
}

' Relationships
User --> Account
Account --> Vehicle
Employee --> ParkingGarage
ParkingGarage --> Vehicle
Vehicle --> ParkingRecord

@enduml