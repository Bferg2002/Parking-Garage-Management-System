@startuml
abstract class Person {
  - name: String
}

class Menu {
  - user: User
  - employee: Employee
  - garage: ParkingGarage
  + start()
  + displayOptions()
}

class User {
  - userId: int
  - email: String
  - vehicles: List<Vehicle>
  + registerVehicle(vehicle: Vehicle)
  + updateVehicleInfo(vehicle: Vehicle)
  + viewAvailableSpaces(): int
  + removeVehicleFromAccount(vehicle: Vehicle)
}

class Employee {
  - employeeId: int
  + trackEntry(vehicle: Vehicle)
  + trackExit(vehicle: Vehicle)
  + checkRegistration(vehicle: Vehicle): boolean
}

class Vehicle {
  - licensePlate: String
  - model
  - brand
  - year
  - isRegistered: boolean
  + displayVehicleInfo(): void {abstract}
}

class Car extends Vehicle{
    + displayVehicleInfo():void
}

class Moterbike extends Vehicle{
    + displayVehicleInfo(): void
}


class ParkingGarage {
  - vehicles:ArrayList<Vehicle>
  - availableSpaces: int
  - occupiedSpaces: int
  + getAvailableSpaces(): int
  + getOccupiedSpaces(): int
  + parkVehicle(vehicle: Vehicle)
  + removeVehicle(vehicle: Vehicle)
}

class ParkingRecord {
  - recordId: int
  - entryTime: DateTime
  - exitTime: DateTime
  - cost: double
  + calculateParkingDuration(): double
  + calculateExpense(vehicle: Vehicle): double

}

' Inheritance
Person <|-- User
Person <|-- Employee

' Menu connects to the three active actors
Menu --> User
Menu --> Employee
Menu --> ParkingGarage

' Original relationships
User --> Account
Account --> Vehicle
Employee --> ParkingGarage
ParkingGarage --> Vehicle
Vehicle --> ParkingRecord

@enduml